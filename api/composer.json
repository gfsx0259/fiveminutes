{
    "name": "rider/api",
    "type": "project",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-pdo": "*",
        "beeterty/clickhouse-php-client": "^1.2",
        "doctrine/collections": "^2.2",
        "guzzlehttp/guzzle": "^7.10",
        "httpsoft/http-message": "^1.1.6",
        "longlang/phpkafka": "^1.2",
        "ory/client": "1.22.36",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "psr/log": "^3.0.2",
        "ramsey/uuid": "^4.9",
        "symfony/console": "^7.4.4",
        "symfony/dotenv": "^7.4",
        "symfony/mailer": "^7.4",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/config": "^1.6.2",
        "yiisoft/data-response": "^2.2",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/http": "^1.3",
        "yiisoft/hydrator": "^1.6.3",
        "yiisoft/injector": "^1.2.1",
        "yiisoft/input-http": "^1.0",
        "yiisoft/log": "^2.2.0",
        "yiisoft/log-target-file": "^3.1",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/request-body-parser": "^1.2.1",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-cycle": "dev-master",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-frankenphp": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        },
        "platform": {
            "php": "8.4.27",
            "ext-frankenphp": "1.0"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/gfsx0259/clickhouse-php-client"
        }
    ]
}
